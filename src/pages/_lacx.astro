---
import Layout from '../layouts/Layout.astro';
import { LACX_DATA } from '../data/lacx';
import { LOCATION } from '../constants';

const { hero, about, classes, categories, instructors, brochure } = LACX_DATA;

// Format WhatsApp URL dynamically from LOCATION
const rawWhatsapp = LOCATION.whatsapp[0]; // '08533877719'
const formattedWhatsapp = rawWhatsapp.startsWith('0') ? '62' + rawWhatsapp.slice(1) : rawWhatsapp;
const waText = encodeURIComponent("Halo Rua Rasa, saya tertarik untuk bertanya lebih lanjut mengenai program edukasi seni budaya Sasak (LACX). Bisa dibantu?");
const waUrl = `https://wa.me/${formattedWhatsapp}?text=${waText}`;
---

<Layout title="LACX - Lombok Art & Culture Experience | Ruarasa">
  <main class="bg-zinc-50">
    <!-- NAVBAR (Sticky & Minimal with Back Button) -->
    <nav class="top-0 z-50 fixed bg-white/80 shadow-xs backdrop-blur-xl border-zinc-200/60 border-b w-full transition-all duration-300">
      <div class="mx-auto px-6 sm:px-8 max-w-7xl">
        <div class="flex justify-between items-center h-16 md:h-20">
          <div class="flex items-center gap-3 md:gap-4">
            <!-- Back Button -->
            <a href="/" class="group flex justify-center items-center bg-zinc-100 hover:bg-amber-100 border border-zinc-200 hover:border-amber-300 rounded-xl md:rounded-2xl w-10 md:w-12 h-10 md:h-12 text-zinc-700 hover:text-amber-800 transition-all shrink-0" title="Kembali ke Beranda">
              <svg class="w-5 md:w-6 h-5 md:h-6 transition-transform group-hover:-translate-x-0.5 transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
              </svg>
            </a>
            
            <a href="/" class="flex items-center gap-2 md:gap-3 shrink-0">
                <img src="/logo.svg" alt="RuaRasa" class="w-auto h-8 md:h-10" />
                <div class="flex flex-col">
                  <span class="font-black text-zinc-900 text-xs md:text-sm leading-none tracking-tight">Rua Rasa</span>
                  <span class="mt-0.5 font-bold text-[8px] text-amber-600 md:text-[9px] uppercase tracking-widest">Immersive Edupark</span>
                </div>
            </a>
          </div>
          
          <div class="hidden md:flex gap-8 font-bold text-zinc-600 text-sm">
            <a href="#curriculum" class="hover:text-amber-600 transition-colors">7 Pilar Seni</a>
            <a href="#join" class="hover:text-amber-600 transition-colors">Unduh Brosur</a>
          </div>

          <div>
            <a href="/" class="bg-zinc-900 hover:bg-amber-500 shadow-md shadow-zinc-950/10 hover:shadow-amber-500/20 hover:shadow-lg px-4 md:px-6 py-2.5 md:py-3 rounded-full font-bold text-white hover:text-zinc-900 text-xs md:text-sm transition-all duration-300">
              Ke Beranda
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="relative flex items-center h-[80vh] min-h-[600px] overflow-hidden">
      <div class="z-0 absolute inset-0">
        <img 
          src="/lacx/hero.jpg" 
          alt="LACX Hero" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-linear-to-b from-black/80 via-black/50 to-zinc-50/20"></div>
      </div>
      
      <div class="z-10 relative mx-auto px-6 text-white container">
        <div class="max-w-3xl" data-aos="fade-up">
          <span class="inline-block bg-amber-500/20 backdrop-blur-md mb-6 px-4 py-1.5 border border-amber-500/30 rounded-full font-bold text-amber-400 text-sm uppercase tracking-widest">
            {hero.subtitle}
          </span>
          <h1 class="drop-shadow-lg mb-6 font-bold text-5xl md:text-7xl leading-tight">
            {hero.title}
          </h1>
          <p class="drop-shadow-md mb-10 max-w-2xl font-light text-white text-xl md:text-2xl leading-relaxed">
            {hero.tagline}
          </p>
          <div class="flex flex-wrap gap-4">
            <a href={waUrl} class="bg-amber-500 hover:bg-amber-600 shadow-amber-500/20 shadow-xl px-8 py-4 rounded-2xl font-bold text-zinc-900 transition-all hover:-translate-y-1 transform">
              Join Program Now
            </a>
            <a href="#curriculum" class="bg-white/10 hover:bg-white/20 backdrop-blur-md px-8 py-4 border border-white/30 rounded-2xl font-bold text-white transition-all hover:-translate-y-1 transform">
              Explore Curriculum
            </a>
          </div>
        </div>
      </div>
      
      <div class="bottom-10 left-1/2 absolute -translate-x-1/2 animate-bounce">
        <div class="flex justify-center p-1 border-2 border-white/30 rounded-full w-6 h-10">
          <div class="bg-white rounded-full w-1 h-2"></div>
        </div>
      </div>
    </section>

    <!-- About LACX -->
    <section class="bg-zinc-50 py-24">
      <div class="mx-auto px-6 container">
        <div class="items-center gap-16 grid md:grid-cols-2">
          <div class="relative" data-aos="fade-right">
             <div class="shadow-2xl rounded-4xl aspect-square overflow-hidden">
                <img src="/lacx/about.jpg" alt="About LACX" class="w-full h-full object-cover" />
             </div>
             <div class="hidden sm:block -right-6 md:-right-8 -bottom-6 md:-bottom-8 absolute bg-amber-500 shadow-xl p-6 md:p-8 rounded-2xl md:rounded-3xl">
                <p class="font-bold text-zinc-900 text-3xl md:text-4xl">100%</p>
                <p class="font-medium text-[10px] text-zinc-800 md:text-sm uppercase tracking-wider">Authentic Sasak</p>
             </div>
          </div>
          
          <div data-aos="fade-left">
            <h2 class="mb-4 font-bold text-amber-600 text-sm uppercase tracking-widest">{about.title}</h2>
            <h3 class="mb-8 font-bold text-zinc-900 text-4xl md:text-5xl leading-tight">
              Edukasi Budaya Berbasis <span class="bg-clip-text bg-linear-to-r from-amber-600 to-orange-500 text-transparent">Immersive Experience</span>
            </h3>
            <p class="mb-10 text-zinc-600 text-lg leading-relaxed">
              {about.description}
            </p>
            
            <div class="gap-6 grid sm:grid-cols-2">
              {about.highlights.map(item => (
                <div class="flex items-center gap-4 bg-white shadow-sm hover:shadow-md p-4 border border-zinc-100 rounded-2xl transition-shadow">
                  <div class="flex justify-center items-center bg-amber-100 rounded-full w-8 h-8 shrink-0">
                    <svg class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <p class="font-bold text-zinc-800 leading-tight">{item}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- The 7 Arts - Dribbble Style Grid -->
    <section class="bg-white py-24" id="curriculum">
      <div class="mx-auto px-6 container">
        <div class="mx-auto mb-16 max-w-2xl text-center">
          <h2 class="mb-4 font-bold text-amber-600 text-sm uppercase tracking-widest">Pilih Bidang Seni</h2>
          <h3 class="font-bold text-zinc-900 text-4xl">7 Pilar Seni Budaya Sasak</h3>
        </div>
        
        <div class="gap-6 md:gap-8 grid md:grid-cols-2 lg:grid-cols-3">
          {categories.map((cat, idx) => (
            <div 
              class={`group relative rounded-2xl md:rounded-3xl overflow-hidden shadow-lg transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl ${idx === 0 ? 'md:col-span-2' : ''}`}
              data-aos="fade-up"
              data-aos-delay={idx * 100}
            >
              <!-- Image & Overlay -->
              <div class="md:h-[450px] aspect-16/10 md:aspect-auto">
                <img src={cat.image} alt={cat.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/40 to-transparent opacity-90"></div>
              </div>

              <!-- Top Badge (Price Type) -->
              <div class="top-4 right-4 z-10 absolute">
                <div class="bg-zinc-900/40 shadow-sm backdrop-blur-md px-3 py-1 border border-white/20 rounded-full font-bold text-[10px] text-white uppercase tracking-wider">
                  {cat.priceType}
                </div>
              </div>
              
              <!-- Content -->
              <div class="absolute inset-0 flex flex-col justify-end p-5 md:p-8">
                <div class="mb-3">
                  <span class="block drop-shadow-sm mb-1 font-bold text-[10px] text-amber-400 md:text-xs uppercase tracking-widest">{cat.subtitle}</span>
                  <h4 class="drop-shadow-md font-bold text-white text-xl md:text-2xl leading-tight">{cat.title}</h4>
                </div>
                
                <p class="md:group-hover:opacity-100 md:opacity-0 mb-4 md:mb-6 md:group-hover:max-h-24 md:max-h-0 overflow-hidden font-medium text-zinc-200 text-xs md:text-sm line-clamp-2 md:line-clamp-none leading-relaxed transition-all duration-500">
                  {cat.description}
                </p>
                
                <div class="flex justify-between items-center">
                  <div class="flex flex-col">
                     <span class="opacity-80 font-bold text-zinc-400 text-xs uppercase tracking-tighter">Mulai dari</span>
                     <span class="font-bold text-amber-500 text-xl md:text-2xl">{cat.price}</span>
                  </div>
                  
                  <a href="#join" class="flex justify-center items-center bg-amber-500 md:group-hover:opacity-100 md:opacity-0 shadow-amber-500/20 shadow-lg rounded-xl md:rounded-full w-10 md:w-12 h-10 md:h-12 text-zinc-900 transition-all md:group-hover:translate-y-0 md:translate-y-10 duration-500 delay-100 transform">
                    <svg class="w-5 md:w-6 h-5 md:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Program Levels -->
    <section class="bg-zinc-900 py-24 overflow-hidden text-white">
      <div class="relative mx-auto px-6 container">
        <div class="mb-20 text-center">
          <h2 class="mb-4 font-bold text-amber-500 text-sm uppercase tracking-widest">Jenjang Program</h2>
          <h3 class="font-bold text-4xl md:text-5xl">Investasikan Waktu Anda</h3>
        </div>
        
        <div class="gap-8 grid lg:grid-cols-3">
          {classes.map((cls, idx) => (
            <div 
              class={`p-10 rounded-4xl border transition-all duration-500 relative flex flex-col h-full ${cls.dark ? 'bg-amber-600 border-amber-500 text-zinc-900 shadow-2xl shadow-amber-600/20' : 'bg-zinc-800/50 border-zinc-700 hover:border-amber-500/50'}`}
              data-aos="fade-up"
              data-aos-delay={idx * 150}
            >
              <span class={`text-sm font-bold uppercase tracking-widest mb-6 ${cls.dark ? 'text-zinc-900/60' : 'text-amber-500'}`}>
                {cls.duration}
              </span>
              <h4 class="mb-6 font-bold text-3xl">{cls.name}</h4>
              <p class={`mb-8 grow leading-relaxed ${cls.dark ? 'text-zinc-950 font-semibold' : 'text-zinc-100'}`}>
                {cls.description}
              </p>
              
              <div class={`mt-auto p-6 rounded-2xl border ${cls.dark ? 'bg-black/10 border-black/10' : 'bg-zinc-950 border-zinc-700'}`}>
                <p class={`text-xs font-bold uppercase tracking-wider mb-2 ${cls.dark ? 'text-zinc-900/60' : 'text-amber-500/80'}`}>Sertifikasi:</p>
                <p class="font-bold">{cls.certificate}</p>
              </div>
              
              {cls.dark && (
                <div class="-top-4 -right-4 absolute bg-zinc-900 shadow-xl px-4 py-1.5 border border-zinc-800 rounded-full font-bold text-amber-500 text-xs uppercase tracking-widest">
                  Best Choice
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Instructors Section -->
    <section class="bg-zinc-50 py-20 md:py-32 overflow-hidden">
      <div class="mx-auto px-6 container">
        <div class="items-center gap-16 grid lg:grid-cols-2">
           <div data-aos="fade-right">
              <h2 class="mb-4 font-bold text-amber-600 text-sm uppercase tracking-widest">Tim Ahli Kami</h2>
              <h3 class="mb-8 font-bold text-zinc-900 text-3xl md:text-5xl leading-tight">{instructors.title}</h3>
              <p class="mb-10 text-zinc-700 text-xl leading-relaxed">
                {instructors.description}
              </p>
              <ul class="space-y-6">
                {instructors.points.map(point => (
                  <li class="flex items-center gap-5 font-semibold text-zinc-900 text-lg">
                    <div class="bg-amber-500 shadow-amber-500/40 shadow-lg rounded-full w-3 h-3 shrink-0"></div>
                    {point}
                  </li>
                ))}
              </ul>
           </div>
           
           <div class="relative" data-aos="fade-left">
              <div class="z-10 relative shadow-2xl rounded-[3rem] aspect-video lg:aspect-square overflow-hidden">
                 <img src="/lacx/instructors.jpg" alt="Instructors" class="w-full h-full object-cover" />
                 <div class="absolute inset-0 bg-linear-to-t from-black/40 to-transparent"></div>
              </div>
              <!-- Decorative elements -->
              <div class="-top-10 -right-10 absolute bg-amber-200/50 blur-3xl rounded-full w-40 h-40"></div>
              <div class="-bottom-10 -left-10 absolute bg-orange-200/50 blur-3xl rounded-full w-40 h-40"></div>
           </div>
        </div>
      </div>
    </section>

    <!-- Custom Program Section -->
    <section class="bg-white py-20 md:py-32">
      <div class="mx-auto px-6 container">
        <div class="mx-auto max-w-5xl">
          <div class="items-center gap-12 grid md:grid-cols-5">
            <div class="md:col-span-3" data-aos="fade-up">
              <h2 class="mb-4 font-bold text-amber-600 text-sm uppercase tracking-widest">Program Fleksibel</h2>
              <h3 class="mb-8 font-bold text-zinc-900 text-4xl md:text-5xl leading-tight">Program Custom Sesuai Kebutuhan Anda</h3>
              <p class="mb-10 text-zinc-700 text-xl leading-relaxed">
                Selain program terstruktur, LACX juga membuka model custom yang sepenuhnya fleksibel: pembelajaran privat, ujian capaian, atau penyesuaian durasi belajar.
              </p>
              <div class="flex flex-wrap gap-4">
                {["Privat & Grup", "Jadwal Fleksibel", "Terbuka untuk WNA"].map(tag => (
                  <div class="bg-zinc-50 shadow-sm px-6 py-3 border border-zinc-200 rounded-2xl font-bold text-zinc-800 text-sm">
                    {tag}
                  </div>
                ))}
              </div>
            </div>
            
            <div class="gap-4 grid grid-cols-2 md:col-span-2" data-aos="fade-up" data-aos-delay="200">
               <div class="bg-zinc-100 rounded-3xl aspect-square overflow-hidden">
                 <img src="/lacx/custom-1.jpg" class="w-full h-full object-cover" />
               </div>
               <div class="bg-zinc-100 mt-8 rounded-3xl aspect-square overflow-hidden">
                 <img src="/lacx/custom-2.jpg" class="w-full h-full object-cover" />
               </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Download Brochure Section -->
    <section class="bg-zinc-950 py-24 overflow-hidden text-white" id="join">
      <div class="mx-auto px-6 container">
        <div class="items-center gap-16 grid lg:grid-cols-2">
          <div data-aos="fade-right">
            <div class="flex justify-center items-center bg-amber-500 shadow-amber-500/20 shadow-xl mb-10 rounded-3xl w-20 h-20 rotate-12">
              <svg class="w-10 h-10 text-zinc-900 -rotate-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="mb-8 font-bold text-4xl md:text-6xl leading-tight">Siap Memulai Perjalanan Budaya Anda?</h3>
            <p class="mb-12 text-zinc-400 text-xl leading-relaxed">
              {brochure.description}
            </p>
            <div class="flex sm:flex-row flex-col gap-6">
              <a 
                href={brochure.fileUrl} 
                class="w-full sm:w-72 flex justify-center items-center gap-3 bg-amber-500 hover:bg-amber-400 shadow-amber-500/10 shadow-xl py-5 rounded-2xl font-bold text-zinc-900 transition-all hover:-translate-y-1 transform"
                download
              >
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                {brochure.buttonText}
              </a>
              <a 
                href={waUrl} 
                class="w-full sm:w-72 flex justify-center items-center py-5 bg-white/5 hover:bg-white/10 border border-white/10 rounded-2xl font-bold text-white transition-all"
              >
                Konsultasi via WhatsApp
              </a>
            </div>
          </div>
          
          <div class="hidden lg:block relative" data-aos="fade-left">
             <div class="bg-zinc-800 shadow-2xl border border-white/10 rounded-[3rem] aspect-4/3 overflow-hidden">
               <img src="/lacx/brochure-preview.png" alt="Brochure Preview" class="w-full h-full object-cover" />
             </div>

          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Premium Typography & Effects */
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap');
  
  :root {
    font-family: 'Outfit', sans-serif;
  }

  /* AOS Mockup (if AOS library is not included, we can add some CSS transitions) */
  [data-aos] {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-aos].aos-animate {
    opacity: 1;
    transform: translateY(0);
  }

  /* Custom Scrollbar for better aesthetic */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #f1f1f1;
  }
  ::-webkit-scrollbar-thumb {
    background: #d4d4d8;
    border-radius: 10px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #a1a1aa;
  }
</style>

<script>
  // Simple intersection observer for animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('aos-animate');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('[data-aos]').forEach(el => observer.observe(el));
</script>
