---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import HomeNav from '../components/home/HomeNav.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import { supabase } from '../lib/supabase';
import { LOCATION } from '../constants';

interface OutingItem {
  date: string;
  time: string;
  school: string;
  students: number;
  status: string;
}

const now = new Date();
const todayWITA = now.toLocaleDateString('en-CA', {
  timeZone: 'Asia/Makassar',
});

// Rentang 3 hari: Hari ini (H) sampai 2 hari ke depan (H+2)
const endDateObj = new Date(now.getTime() + 2 * 24 * 60 * 60 * 1000);
const threeDaysLaterWITA = endDateObj.toLocaleDateString('en-CA', {
  timeZone: 'Asia/Makassar',
});

let allOutings: OutingItem[] = [];
try {
  const { data, error } = await supabase
    .from('outing_schedules')
    .select('*')
    .gte('visit_date', todayWITA)
    .lte('visit_date', threeDaysLaterWITA)
    .order('visit_date', { ascending: true })
    .order('visit_time', { ascending: true });

  if (!error && data) {
    allOutings = data.map((item) => ({
      date: String(item.visit_date),
      time: String(item.visit_time || '09:00 WITA'),
      school: String(item.school_name),
      students: Number(item.students || 0),
      status: String(item.status || 'Terbooking'),
    }));
  }
} catch (e) {
  console.error('Failed to fetch outing schedules from Supabase:', e);
}

const formatIndonesianDate = (dateStr: string) => {
  try {
    const dateObj = new Date(`${dateStr}T00:00:00+08:00`);
    return dateObj.toLocaleDateString('id-ID', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'Asia/Makassar',
    });
  } catch {
    return dateStr;
  }
};

const waMessage = encodeURIComponent(
  'Halo Rua Rasa, saya tertarik untuk bertanya atau melakukan booking jadwal Outing Class untuk sekolah/lembaga kami. Bisa dibantu informasi ketersediaan paketnya?'
);
---

<Layout title="Jadwal Outing Class - Rua Rasa" bodyClass="bg-zinc-50 text-zinc-900 selection:bg-zinc-900 selection:text-sky-400">
  <HomeNav />

  <main class="relative mx-auto px-4 md:px-6 pt-28 md:pt-36 pb-20 max-w-5xl min-h-screen">
    <div class="top-20 right-0 -z-10 absolute bg-sky-200/40 blur-[120px] rounded-full w-[250px] md:w-[500px] h-[250px] md:h-[500px] mix-blend-multiply"></div>
    <div class="bottom-20 left-0 -z-10 absolute bg-emerald-100/40 blur-[100px] rounded-full w-[200px] md:w-[400px] h-[200px] md:h-[400px] mix-blend-multiply"></div>

    <div class="mb-12 text-center">
      <div class="inline-flex items-center gap-2 bg-emerald-100/60 mb-4 px-3.5 py-1.5 border border-emerald-200/80 rounded-full font-extrabold text-[10px] text-emerald-800 uppercase tracking-widest">
        <span class="bg-emerald-600 rounded-full w-2 h-2 animate-pulse"></span>
        Outing Class & Gathering
      </div>
      <h1 class="bg-clip-text bg-gradient-to-r from-zinc-900 via-emerald-800 to-zinc-900 font-black text-transparent text-4xl md:text-6xl leading-tight tracking-tight">
        Jadwal Outing Class
      </h1>
      <p class="mx-auto mt-4 max-w-2xl font-medium text-zinc-500 text-sm md:text-base leading-relaxed">
        Kunjungan belajar dan kebersamaan di Rua Rasa Immersive Edupark (Jadwal 3 Hari Terdekat). Hubungi kami untuk memesan slot kunjungan sekolah atau instansi Anda.
      </p>
    </div>

    <div class="bg-white/80 shadow-2xl backdrop-blur-xl p-6 md:p-8 border border-zinc-200/60 rounded-3xl overflow-hidden transition-all duration-300">
      {allOutings.length === 0 ? (
        <div class="py-16 text-zinc-400 text-center">
          <div class="mb-4 text-5xl">📅</div>
          <p class="font-extrabold text-zinc-700 text-lg">Belum Ada Jadwal Outing dalam 3 Hari ke Depan</p>
          <p class="mt-1 text-zinc-500 text-sm">Belum ada kunjungan outing sekolah yang dijadwalkan untuk 3 hari terdekat.</p>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left">
            <thead>
              <tr class="border-zinc-200/80 border-b font-bold text-zinc-400 text-xs uppercase tracking-wider">
                <th class="px-4 py-4">Tanggal</th>
                <th class="px-4 py-4">Jam Kedatangan</th>
                <th class="px-4 py-4">Nama Sekolah / Instansi</th>
                <th class="px-4 py-4 text-center">Jumlah Siswa</th>
                <th class="px-4 py-4 text-right">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-100 font-medium">
              {allOutings.map((outing) => (
                <tr class="group hover:bg-zinc-50/60 border-l-4 border-l-transparent hover:border-l-emerald-500 transition-all duration-300">
                  <td class="px-4 py-5 font-extrabold text-zinc-900 whitespace-nowrap">
                    <div class="flex items-center gap-2">
                      <span>{formatIndonesianDate(outing.date)}</span>
                      {outing.date === todayWITA && (
                        <span class="bg-emerald-500 px-2 py-0.5 rounded-full font-black text-[10px] text-white uppercase tracking-wider">
                          Hari Ini
                        </span>
                      )}
                    </div>
                  </td>
                  <td class="px-4 py-5 whitespace-nowrap">
                    <span class="inline-flex items-center gap-1.5 bg-zinc-100/80 px-3 py-1 rounded-full ring-1 ring-zinc-200/50 font-bold text-zinc-700 text-xs">
                      🕒 {outing.time}
                    </span>
                  </td>
                  <td class="px-4 py-5 font-extrabold text-zinc-800 text-sm md:text-base">
                    <div class="flex items-center gap-3">
                      <span class="drop-shadow-sm text-xl group-hover:scale-110 transition-transform duration-300 filter">🏫</span>
                      <span class="group-hover:text-emerald-800 transition-colors">{outing.school}</span>
                    </div>
                  </td>
                  <td class="px-4 py-5 text-center">
                    <span class="bg-sky-50 px-3.5 py-1.5 rounded-full ring-1 ring-sky-200/50 font-black text-sky-700 text-xs">
                      {outing.students} Siswa
                    </span>
                  </td>
                  <td class="px-4 py-5 text-right whitespace-nowrap">
                    {outing.status === 'Terbooking' ? (
                      <span class="inline-flex items-center gap-1.5 bg-sky-50 px-3 py-1 border border-sky-200 rounded-full font-black text-[10px] text-sky-700 uppercase tracking-wider">
                        <span class="bg-sky-500 rounded-full w-1.5 h-1.5 animate-ping"></span>
                        {outing.status}
                      </span>
                    ) : (
                      <span class="inline-flex items-center gap-1.5 bg-zinc-100 px-3 py-1 border border-zinc-200 rounded-full font-black text-[10px] text-zinc-500 uppercase tracking-wider">
                        {outing.status}
                      </span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <div class="group relative bg-zinc-900 shadow-2xl hover:shadow-emerald-950/20 mt-12 p-8 md:p-14 border border-zinc-800 rounded-4xl overflow-hidden text-white text-center transition-all duration-500">
      <div class="-top-16 -left-16 absolute bg-emerald-500/10 blur-[80px] rounded-full w-[250px] h-[250px] pointer-events-none"></div>
      <div class="-right-16 -bottom-16 absolute bg-sky-500/10 blur-[80px] rounded-full w-[250px] h-[250px] pointer-events-none"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:14px_24px] pointer-events-none"></div>
      <div class="hidden lg:block top-1/2 left-14 absolute text-6xl -translate-y-1/2 animate-bounce pointer-events-none select-none" style="animation-duration: 4s;">
        🚌
      </div>
      <div class="hidden lg:block top-1/2 right-14 absolute text-6xl -translate-y-1/2 animate-bounce pointer-events-none select-none" style="animation-duration: 3s; animation-delay: 0.5s;">
        🎒
      </div>

      <div class="z-10 relative mx-auto max-w-lg">
        <h2 class="font-black text-3xl md:text-4xl leading-tight tracking-tight">
          Ingin Mengadakan <br class="sm:hidden"/><span class="bg-clip-text bg-gradient-to-r from-emerald-400 to-sky-400 text-transparent">Outing Class</span>?
        </h2>
        <p class="mt-4 font-medium text-zinc-400 text-sm md:text-base leading-relaxed">
          Dapatkan pengalaman belajar yang interaktif dan menyenangkan untuk siswa Anda dengan harga paket spesial rombongan.
        </p>
        <div class="flex justify-center mt-8">
          <a 
            href={`https://wa.me/62${LOCATION.whatsapp[0].substring(1)}?text=${waMessage}`}
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-gradient-to-r from-emerald-500 hover:from-emerald-400 to-teal-500 hover:to-teal-400 shadow-[0_8px_30px_rgb(16,185,129,0.3)] hover:shadow-[0_8px_30px_rgb(16,185,129,0.5)] px-8 py-4 rounded-full font-black text-white text-sm md:text-base hover:scale-[1.03] active:scale-[0.97] transition-all duration-300 transform"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" class="fill-current w-5 h-5"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L3 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
            Hubungi via WhatsApp
          </a>
        </div>
      </div>
    </div>
  </main>

  <HomeFooter />
</Layout>