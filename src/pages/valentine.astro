---
import Layout from '../layouts/Layout.astro';
import { getCurrentTheme } from '../utils/themeManager';
import { HERO_IMAGES, VALENTINE_IMAGES, ATTRACTION_IMAGES, ABOUT_IMAGES, LOCATION, VALENTINE_FAQ_DATA } from '../constants';

const theme = getCurrentTheme();
---

<Layout title="Rua Rasa - Valentine Edition" bodyClass="bg-valentine-bg text-zinc-900 selection:bg-valentine-600 selection:text-white">
  <!-- Dynamic Theme Injection -->
  <style define:vars={{
    'theme-primary': theme.colors.primary,
    'theme-secondary': theme.colors.secondary,
    'theme-bg-start': theme.colors.backgroundStart,
    'theme-bg-end': theme.colors.backgroundEnd,
    'theme-highlight': theme.colors.textHighlight,
  }}>
    :root {
      --primary: var(--theme-primary);
      --secondary: var(--theme-secondary);
      --highlight: var(--theme-highlight);
    }
    
    /* Subtle Grain for Texture (Paper feel) */
    .bg-paper {
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
    }

    /* Modern Gradient Text for Light Mode - High Contrast */
    .text-gradient {
      background: linear-gradient(135deg, #18181b 0%, #0284c7 100%); /* Zinc-900 to sky-600 */
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Soft Cards */
    .soft-panel {
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.05);
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
      transition: all 0.3s ease;
    }
    
    .soft-panel:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
      border-color: #0284c7; /* sky-600 */
    }
    
    
    /* Ticker Animation - Seamless Loop */
    @keyframes ticker {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    .animate-ticker {
      display: inline-flex;
      animation: ticker 30s linear infinite;
    }
    .ticker-content {
      display: flex;
      padding-right: 2rem;
    }
    
    /* Image Slideshow Animation */
    @keyframes slideshow {
      0%, 30% { opacity: 1; }
      33%, 97% { opacity: 0; }
      100% { opacity: 1; }
    }
    .slideshow-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      animation: slideshow 12s infinite;
    }
    .slideshow-img:nth-child(1) { animation-delay: 0s; }
    .slideshow-img:nth-child(2) { animation-delay: 4s; }
    .slideshow-img:nth-child(3) { animation-delay: 8s; }
  </style>

  <!-- NAVBAR (Sticky & Minimal) -->
  <nav class="top-0 z-50 fixed bg-valentine-nav/90 shadow-sm backdrop-blur-xl border-valentine-300 border-b w-full">
    <div class="mx-auto px-6 sm:px-6 lg:px-8 max-w-7xl">
      <div class="flex justify-between items-center h-16 md:h-20">
        <a href="/" class="flex items-center gap-3 shrink-0">
            <img src="/logo.svg" alt="RuaRasa" class="w-auto h-8 md:h-10" />
            <div class="flex flex-col">
              <span class="font-black text-zinc-900 text-xs md:text-lg leading-none tracking-tight">Rua Rasa Lombok</span>
              <span class="font-semibold text-[8px] text-valentine-500 md:text-[10px] uppercase tracking-widest">Tempat Cinta Berlabuh💕</span>
            </div>
        </a>
        
        <div class="hidden md:flex gap-8 font-bold text-zinc-600 text-sm">
          <a href="#about" class="hover:text-valentine-600 decoration-2 hover:underline underline-offset-4 transition-all">Tentang</a>
          <a href="#explore" class="hover:text-valentine-600 decoration-2 hover:underline underline-offset-4 transition-all">Wahana</a>
          <a href="#ticket" class="hover:text-valentine-600 decoration-2 hover:underline underline-offset-4 transition-all">Harga</a>
          <a href="#faq" class="hover:text-valentine-600 decoration-2 hover:underline underline-offset-4 transition-all">FAQ</a>
        </div>

        <div>
          <a href="/ticket-valentine" class="bg-zinc-900 hover:bg-valentine-500 shadow-lg shadow-zinc-900/20 hover:shadow-valentine-500/30 px-4 md:px-6 py-2.5 md:py-3 rounded-full font-bold text-white text-xs md:text-sm transition-all hover:-translate-y-0.5 duration-300">
            <span class="hidden sm:inline">Booking</span> Tiket
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- HERO SECTION (Valentine Theme) -->
  <header class="relative flex flex-col justify-center mx-auto px-6 md:px-8 pt-24 md:pt-32 pb-12 md:pb-20 max-w-7xl min-h-[90vh] md:min-h-screen">
    
    <!-- Decorative Blob - Valentine Colors -->
    <div class="top-20 right-0 -z-10 absolute bg-valentine-300/50 blur-[100px] rounded-full w-[300px] md:w-[500px] h-[300px] md:h-[500px] mix-blend-multiply"></div>
     <div class="bottom-20 left-0 -z-10 absolute bg-valentine-200/50 blur-[80px] rounded-full w-[200px] md:w-[300px] h-[200px] md:h-[300px] mix-blend-multiply"></div>

    <div class="items-center gap-8 md:gap-12 grid grid-cols-1 md:grid-cols-2">
      <div class="z-10 relative md:text-left text-center">
        <div class="inline-flex items-center gap-2 bg-valentine-100 mb-4 md:mb-6 px-3 md:px-4 py-1.5 md:py-2 border border-valentine-200 rounded-full font-bold text-[10px] text-valentine-700 md:text-xs uppercase tracking-wider">
          <span class="bg-valentine-500 rounded-full w-1.5 md:w-2 h-1.5 md:h-2"></span>
          Valentine Special 💕
        </div>
        
        <h1 class="mb-6 md:mb-8 font-black text-zinc-900 text-4xl sm:text-5xl md:text-7xl lg:text-8xl leading-[1.1] tracking-tight">
          Love <br class="hidden sm:block"/>
          Meets <br class="hidden sm:block"/>
          <span class="inline-block relative">
            <span class="z-10 relative text-valentine-500">Light Art.</span>
            <span class="bottom-2 md:bottom-4 left-0 z-0 absolute bg-valentine-300/50 w-full h-2 md:h-3 -rotate-2"></span>
          </span>
        </h1>
        
        <p class="mx-auto md:mx-0 mb-4 md:mb-6 max-w-lg font-medium text-zinc-600 text-sm md:text-lg leading-relaxed">
          Rayakan momen spesial bersama pasangan di destinasi paling romantis di Lombok. Ciptakan kenangan indah yang tak terlupakan! 💕
        </p>

        <div class="flex sm:flex-row flex-col justify-center md:justify-start items-center gap-3 md:gap-4">
          <a href="/ticket-valentine" class="flex justify-center items-center gap-2 md:gap-3 bg-zinc-900 hover:bg-valentine-500 shadow-xl shadow-zinc-200 hover:shadow-valentine-500/20 px-6 md:px-8 py-3 md:py-4 rounded-xl md:rounded-2xl w-full sm:w-auto font-bold text-white text-base md:text-lg transition-all hover:-translate-y-1">
            Booking Sekarang 🤍
            <span>→</span>
          </a>
        </div>
      </div>
      
      <!-- Abstract Image Composition (Hidden on mobile) -->
      <div class="hidden md:block relative h-[500px] lg:h-[600px]">
        <div class="top-0 right-0 z-10 absolute shadow-2xl rounded-4xl ring-1 ring-black/5 w-4/5 h-4/5 overflow-hidden rotate-3 hover:rotate-0 transition-all duration-500">
             <img src={HERO_IMAGES.main} alt="Immersive Light" class="w-full h-full object-cover">
        </div>
        <div class="bottom-8 left-0 z-20 absolute shadow-2xl border-8 border-white rounded-4xl ring-1 ring-black/5 w-3/5 h-3/5 overflow-hidden -rotate-6 hover:rotate-0 transition-all duration-500">
             <img src={HERO_IMAGES.secondary} alt="Neon Art" class="w-full h-full object-cover">
        </div>
      </div>
    </div>
  </header>

   <!-- RUNNING TEXT BANNER - Valentine Theme -->
   <div class="bg-valentine-bg py-2 md:py-4 w-full overflow-hidden">
     <div class="bg-valentine-500 shadow-lg py-2 md:py-4 border-valentine-700 border-y-2 md:border-y-4 overflow-hidden -rotate-1 scale-105 origin-center transform">
        <div class="animate-ticker">
          <span class="font-black text-white text-sm md:text-xl uppercase tracking-widest whitespace-nowrap ticker-content">
            💕 Valentine Special &nbsp;&nbsp;•&nbsp;&nbsp; Romantic Light Art &nbsp;&nbsp;•&nbsp;&nbsp; Date Night Destination &nbsp;&nbsp;•&nbsp;&nbsp; Instagrammable Spots &nbsp;&nbsp;•&nbsp;&nbsp; Open 08:00 - 21:30 WITA &nbsp;&nbsp;•&nbsp;&nbsp; Create Memories Together &nbsp;&nbsp;•&nbsp;&nbsp;
          </span>
          <span class="font-black text-white text-sm md:text-xl uppercase tracking-widest whitespace-nowrap ticker-content">
            💕 Valentine Special &nbsp;&nbsp;•&nbsp;&nbsp; Romantic Light Art &nbsp;&nbsp;•&nbsp;&nbsp; Date Night Destination &nbsp;&nbsp;•&nbsp;&nbsp; Instagrammable Spots &nbsp;&nbsp;•&nbsp;&nbsp; Open 08:00 - 21:30 WITA &nbsp;&nbsp;•&nbsp;&nbsp; Create Memories Together &nbsp;&nbsp;•&nbsp;&nbsp;
          </span>
        </div>
     </div>
   </div>

  <!-- TENTANG RUA RASA Section - Valentine Theme -->
  <section id="about" class="bg-valentine-bg pt-16 md:pt-24 pb-16 md:pb-24">
    <div class="mx-auto px-6 md:px-8 max-w-6xl">
      <div class="items-center gap-8 md:gap-16 grid grid-cols-1 md:grid-cols-2">
        <!-- Left: Image with decorative frame -->
        <div class="relative pt-4 pl-4">
          <div class="z-10 relative">
            <div class="shadow-2xl border-4 border-white rounded-3xl overflow-hidden -rotate-3 hover:rotate-0 transition-transform duration-500">
              <img src={ABOUT_IMAGES.card_valentine} alt="Rua Rasa Experience" class="w-full h-[300px] md:h-[400px] object-cover" />
            </div>
          </div>
          <!-- Decorative elements - Valentine Color -->
          <div class="top-0 left-0 -z-10 absolute bg-valentine-300 rounded-3xl w-full h-full"></div>
        </div>

        <!-- Right: Text Content -->
        <div class="py-4 md:py-0">
          <h2 class="mb-3 font-black text-zinc-900 text-xl md:text-2xl lg:text-3xl leading-tight">
            Kenapa <span class="text-valentine-500">Rua Rasa</span> Jadi Tempat Cinta Berlabuh? 💕
          </h2>
          <p class="mb-5 font-medium text-zinc-500 text-sm md:text-base">
            Destinasi romantis di mana cinta dan cahaya bertemu dalam satu momen indah!
          </p>
          
          <div class="space-y-4 font-medium text-zinc-600 text-sm md:text-base leading-relaxed">
            <p>
              Cari tempat spesial untuk rayakan Valentine bersama pasangan? <strong class="text-zinc-800">Rua Rasa</strong> adalah jawabannya! Di sini, kalian bisa menikmati pengalaman romantis yang menggabungkan <strong class="text-zinc-800">seni cahaya imersif</strong> dengan suasana yang hangat dan penuh makna.
            </p>
            <p>
              Bayangkan jalan berdua di antara instalasi cahaya yang memukau, foto-foto di spot romantis, dan menciptakan kenangan tak terlupakan bersama orang terkasih. <strong class="text-valentine-600">Tempat Cinta Berlabuh</strong> — di mana setiap momen jadi cerita cinta kalian! 😉
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- KENAPA KE RUA RASA? Section -->
  <section id="facilities" class="bg-valentine-bg py-16 md:py-24 valentine-divider">
    <div class="mx-auto px-6 max-w-6xl">
      <div class="mb-10 md:mb-14 text-center">
        <h2 class="mb-3 font-black text-zinc-900 text-3xl md:text-4xl lg:text-5xl"><span class="text-valentine-500">Couple-an</span> ala Rua Rasa</h2>
        <p class="mx-auto max-w-2xl font-medium text-zinc-500 text-base md:text-lg">Rayakan hari kasih sayang dengan beragam aktivitas seru yang bikin makin lengket! 💕</p>
      </div>
      
      <div class="gap-6 md:gap-8 grid grid-cols-2 md:grid-cols-4">
        <!-- Reason 1: Couple Activity -->
        <div class="group relative p-5 md:p-6 text-center">
          <div class="z-10 relative flex justify-center items-center bg-linear-to-br from-pink-400 to-rose-500 shadow-lg shadow-rose-200 group-hover:shadow-rose-400/50 mx-auto mb-4 rounded-2xl w-16 md:w-20 h-16 md:h-20 text-white group-hover:scale-110 transition-all duration-300 transform">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="drop-shadow-md w-8 md:w-10 h-8 md:h-10"><path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" /></svg>
          </div>
          <h3 class="mb-2 font-bold text-zinc-900 text-sm md:text-base">Couple Activity</h3>
          <p class="text-zinc-500 text-xs md:text-sm leading-relaxed">Bikin gelang pasangan bareng doi sebagai simbol cinta yang manis.</p>
        </div>
        
        <!-- Reason 2: Romantic Spots -->
        <div class="group relative p-5 md:p-6 text-center">
          <div class="z-10 relative flex justify-center items-center bg-linear-to-br from-violet-400 to-fuchsia-500 shadow-lg shadow-violet-200 group-hover:shadow-violet-400/50 mx-auto mb-4 rounded-2xl w-16 md:w-20 h-16 md:h-20 text-white group-hover:scale-110 transition-all duration-300 transform">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="drop-shadow-md w-8 md:w-10 h-8 md:h-10"><path d="M12 9a3.75 3.75 0 100 7.5A3.75 3.75 0 0012 9z" /><path fill-rule="evenodd" d="M9.344 3.071a49.52 49.52 0 015.312 0c.967.052 1.83.585 2.332 1.39l.821 1.317c.24.383.645.643 1.11.71.386.054.77.113 1.152.177 1.432.239 2.429 1.493 2.429 2.909V18a3 3 0 01-3 3h-15a3 3 0 01-3-3V9.574c0-1.416.997-2.67 2.429-2.909.382-.064.766-.123 1.151-.178a1.56 1.56 0 001.11-.71l.822-1.315a2.942 2.942 0 012.332-1.39zM6.75 12.75a5.25 5.25 0 1110.5 0 5.25 5.25 0 01-10.5 0zm12-1.5a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" /></svg>
          </div>
          <h3 class="mb-2 font-bold text-zinc-900 text-sm md:text-base">Romantic Spots</h3>
          <p class="text-zinc-500 text-xs md:text-sm leading-relaxed">Abadikan momen mesra di instalasi cahaya & balon udara yang estetik.</p>
        </div>
        
        <!-- Reason 3: Dinner -->
        <div class="group relative p-5 md:p-6 text-center">
          <div class="z-10 relative flex justify-center items-center bg-linear-to-br from-amber-400 to-orange-500 shadow-lg shadow-orange-200 group-hover:shadow-orange-400/50 mx-auto mb-4 rounded-2xl w-16 md:w-20 h-16 md:h-20 text-white group-hover:scale-110 transition-all duration-300 transform">
             <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="drop-shadow-md w-8 md:w-10 h-8 md:h-10"><path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z" /></svg>
          </div>
          <h3 class="mb-2 font-bold text-zinc-900 text-sm md:text-base">Intimate Dinner</h3>
          <p class="text-zinc-500 text-xs md:text-sm leading-relaxed">Nikmati hidangan lezat berdua dengan suasana yang hangat dan privat.</p>
        </div>

        <!-- Reason 4: Best Value -->
        <div class="group relative p-5 md:p-6 text-center">
          <div class="z-10 relative flex justify-center items-center bg-linear-to-br from-emerald-400 to-teal-500 shadow-lg shadow-teal-200 group-hover:shadow-teal-400/50 mx-auto mb-4 rounded-2xl w-16 md:w-20 h-16 md:h-20 text-white group-hover:scale-110 transition-all duration-300 transform">
             <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="drop-shadow-md w-8 md:w-10 h-8 md:h-10"><path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 00-5.25 5.25v3a3 3 0 00-3 3v6.75a3 3 0 003 3h10.5a3 3 0 003-3v-6.75a3 3 0 00-3-3v-3c0-2.9-2.35-5.25-5.25-5.25zm3.75 8.25v-3a3.75 3.75 0 10-7.5 0v3h7.5z" clip-rule="evenodd" /><path d="M9.75 14.25a.75.75 0 00-1.5 0v3a.75.75 0 001.5 0v-3zM12.75 14.25a.75.75 0 00-1.5 0v3a.75.75 0 001.5 0v-3zM15.75 14.25a.75.75 0 00-1.5 0v3a.75.75 0 001.5 0v-3z" /></svg>
          </div>
          <h3 class="mb-2 font-bold text-zinc-900 text-sm md:text-base">Best Value Date</h3>
          <p class="text-zinc-500 text-xs md:text-sm leading-relaxed">Mulai 129rb/couple sudah dapat tiket, snack, & aktivitas seru!</p>
        </div>
      </div>
    </div>
    
    <!-- Fluid Wave Image -->
    <div class="relative mt-12 md:mt-16 w-full">
      <img src={ABOUT_IMAGES.fluid_valentine} alt="Rua Rasa History" class="w-full h-auto object-cover" />
    </div>
  </section>

  <!-- BENTO GRID (Clean Style) -->
  <!-- BENTO GRID (Compact & Relevant) -->
  <section id="explore" class="mx-auto px-6 pb-16 md:pb-24 max-w-6xl">
    <div class="mb-8 md:mb-12 text-center">
       <div class="inline-flex items-center gap-2 bg-valentine-100 mb-3 md:mb-4 px-3 py-1 border border-valentine-200 rounded-full font-bold text-[10px] text-valentine-800 md:text-xs uppercase tracking-wider">
          <span class="bg-valentine-600 rounded-full w-1.5 md:w-2 h-1.5 md:h-2 animate-pulse"></span>
          Explore Our World
       </div>
       <h2 class="font-black text-zinc-900 text-3xl md:text-4xl lg:text-5xl leading-tight">Wahana Utama</h2>
    </div>

    <div class="gap-3 md:gap-4 grid grid-cols-2 md:grid-cols-4 md:grid-rows-2 md:h-[480px]">
        <!-- 1. Immersive Edupark (Full width on mobile, 2x2 on desktop) -->
        <div class="group relative col-span-2 md:col-span-2 md:row-span-2 shadow-sm hover:shadow-xl rounded-2xl md:rounded-4xl ring-1 ring-zinc-200 h-[180px] md:h-full overflow-hidden transition-all duration-500 cursor-pointer">
             <!-- Image Slideshow -->
             <img src={VALENTINE_IMAGES[0]} class="slideshow-img" alt="Immersive Show 1" />
             <img src={VALENTINE_IMAGES[1]} class="slideshow-img" alt="Immersive Show 2" />
             <img src={VALENTINE_IMAGES[2]} class="slideshow-img" alt="Immersive Show 3" />
             <div class="z-10 absolute inset-0 flex flex-col justify-end bg-linear-to-t from-black/80 via-black/20 to-transparent p-4 md:p-6 lg:p-8">
                <div class="inline-flex bg-white/90 shadow-sm mb-2 md:mb-3 px-3 md:px-4 py-1 md:py-1.5 border border-valentine-200 rounded-full w-fit font-bold text-[10px] text-valentine-600 md:text-xs uppercase">Signature</div>
                <h3 class="font-black text-white text-base md:text-2xl lg:text-3xl leading-tight">Immersive Edupark</h3>
                <p class="hidden md:block mt-2 font-medium text-zinc-300 text-sm md:text-base line-clamp-2">
                  Rasakan magisnya seni cahaya interaktif. Suasana romantis untuk momen spesialmu.
                </p>
             </div>
        </div>

        <!-- 2. Kid Zone (1x1) -->
        <div class="group relative bg-violet-200 rounded-2xl md:rounded-4xl ring-1 ring-zinc-200 h-[140px] md:h-auto overflow-hidden cursor-pointer">
             <img src={ATTRACTION_IMAGES.kidZone} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Kid Zone" />
             <div class="top-2 md:top-4 right-2 md:right-4 z-10 absolute bg-white/90 shadow-sm px-2 md:px-3 py-0.5 md:py-1 border border-violet-200 rounded-full font-bold text-[8px] text-violet-600 md:text-[10px]">KIDS</div>
             <div class="absolute inset-0 flex flex-col justify-end bg-linear-to-t from-violet-900/80 to-transparent p-3 md:p-5">
                <h3 class="font-bold text-white text-sm md:text-lg transition-transform md:group-hover:-translate-y-1 duration-300">Kid Zone</h3>
                <p class="hidden md:block opacity-0 md:group-hover:opacity-100 mt-1 max-h-0 md:group-hover:max-h-20 overflow-hidden text-violet-200 text-xs leading-relaxed transition-all duration-300">Area bermain anak dengan permainan edukatif yang menyenangkan.</p>
             </div>
        </div>

        <!-- 3. Photo Booth (1x1) -->
        <div class="group relative bg-amber-100 rounded-2xl md:rounded-4xl ring-1 ring-zinc-200 h-[140px] md:h-auto overflow-hidden cursor-pointer">
             <div class="top-2 md:top-4 right-2 md:right-4 z-10 absolute bg-white/90 shadow-sm px-2 md:px-3 py-0.5 md:py-1 border border-amber-200 rounded-full font-bold text-[8px] text-amber-600 md:text-[10px]">AUTHENTIC</div>
             <img src={ATTRACTION_IMAGES.photoBooth} class="opacity-90 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Photo Booth" />
             <div class="absolute inset-0 flex flex-col justify-end bg-linear-to-t from-amber-900/80 to-transparent p-3 md:p-5">
                <h3 class="font-bold text-white text-sm md:text-lg transition-transform md:group-hover:-translate-y-1 duration-300">Smart Photo Booth</h3>
                <p class="hidden md:block opacity-0 md:group-hover:opacity-100 mt-1 max-h-0 md:group-hover:max-h-20 overflow-hidden text-amber-200 text-xs leading-relaxed transition-all duration-300">Abadikan momen mesra kalian. Tersedia template couple & langsung cetak!</p>
             </div>
        </div>

