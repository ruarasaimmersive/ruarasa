---
// src/components/home/HomeNav.astro
---
<!-- NAVBAR (Sticky & Minimal) -->
<nav class="top-0 z-50 fixed bg-white/90 shadow-sm backdrop-blur-xl border-zinc-200 border-b w-full">
  <div class="mx-auto px-6 sm:px-6 lg:px-8 max-w-7xl">
    <div class="flex justify-between items-center h-16 md:h-20">
      <a href="/" class="flex items-center gap-3 shrink-0">
          <img src="/logo.svg" alt="RuaRasa" class="w-auto h-8 md:h-10" />
          <div class="flex flex-col">
            <span class="font-black text-zinc-900 text-xs md:text-lg leading-none tracking-tight">Rua Rasa Lombok</span>
            <span class="font-medium text-[8px] text-sky-600 md:text-[10px] uppercase tracking-widest">Immersive Edupark</span>
          </div>
      </a>
      
      <div class="hidden md:flex gap-8 font-bold text-zinc-600 text-sm">
        <a href="/#about" class="hover:text-sky-700 decoration-2 hover:underline underline-offset-4 transition-all">Tentang</a>
        <a href="/#explore" class="hover:text-sky-700 decoration-2 hover:underline underline-offset-4 transition-all">Wahana</a>
        <a href="/#ticket" class="hover:text-sky-700 decoration-2 hover:underline underline-offset-4 transition-all">Harga</a>
        <!-- <a href="/lacx" class="text-amber-600 hover:text-amber-700 decoration-2 hover:underline underline-offset-4 transition-all font-bold">Kelas Budaya</a> -->
        <a href="/#faq" class="hover:text-sky-700 decoration-2 hover:underline underline-offset-4 transition-all">FAQ</a>
        <a href="/outing" class="hover:text-sky-700 decoration-2 hover:underline underline-offset-4 transition-all">Outing</a>
      </div>

      <div>
        <a href="/ticket" class="bg-zinc-900 hover:bg-sky-600 shadow-lg shadow-zinc-900/20 hover:shadow-sky-600/30 px-4 md:px-6 py-2.5 md:py-3 rounded-full font-bold text-white text-xs md:text-sm transition-all hover:-translate-y-0.5 duration-300">
          <span class="hidden sm:inline">Booking</span> Tiket
        </a>
      </div>
    </div>
  </div>
</nav>
