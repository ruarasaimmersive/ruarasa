---
// src/components/home/LocationInfo.astro
import { LOCATION } from '../../constants';
---
<!-- LOKASI / VENUE Section -->
<section id="location" class="bg-white py-16 md:py-24 border-zinc-100 border-t">
  <div class="mx-auto px-6 max-w-6xl">
    <div class="mb-10 md:mb-14 text-center">
      <div class="inline-flex items-center gap-2 bg-sky-100 mb-3 md:mb-4 px-3 py-1 border border-sky-200 rounded-full font-bold text-[10px] text-sky-800 md:text-xs uppercase tracking-wider">
        <span class="text-base">📍</span>
        Lokasi Kami
      </div>
      <h2 class="mb-3 font-black text-zinc-900 text-3xl md:text-4xl lg:text-5xl">Temukan <span class="text-sky-600">Rua Rasa</span></h2>
      <p class="mx-auto max-w-2xl font-medium text-zinc-500 text-base md:text-lg">Terletak di jantung Lombok, mudah dijangkau dari berbagai arah.</p>
    </div>
    
    <div class="gap-6 md:gap-8 grid grid-cols-1 md:grid-cols-2">
      <!-- Map Embed -->
      <div class="bg-zinc-100 rounded-2xl md:rounded-3xl ring-1 ring-zinc-200 min-h-[280px] md:min-h-[400px] overflow-hidden">
        <iframe 
          src={LOCATION.mapsEmbedUrl}
          width="100%" 
          height="100%" 
          style="border:0; min-height: 280px;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
          class="grayscale hover:grayscale-0 w-full h-full transition-all duration-500">
        </iframe>
      </div>
      
      <!-- Location Info -->
      <div class="flex flex-col justify-center bg-zinc-50 p-5 md:p-8 rounded-2xl md:rounded-3xl">
        <h3 class="mb-4 font-bold text-zinc-900 text-lg md:text-2xl">{LOCATION.name}</h3>
        
        <div class="space-y-3 md:space-y-4 mb-5 md:mb-6">
          <div class="flex items-start gap-3">
            <div class="flex justify-center items-center bg-sky-100 rounded-lg w-9 md:w-10 h-9 md:h-10 text-base md:text-lg shrink-0">🏠</div>
            <div>
              <p class="font-semibold text-zinc-800 text-xs md:text-sm">Alamat</p>
              <p class="text-zinc-600 text-xs md:text-sm">{LOCATION.address}</p>
            </div>
          </div>
          
          <div class="flex items-start gap-3">
            <div class="flex justify-center items-center bg-amber-100 rounded-lg w-9 md:w-10 h-9 md:h-10 text-base md:text-lg shrink-0">🕐</div>
            <div>
              <p class="font-semibold text-zinc-800 text-xs md:text-sm">Jam Operasional</p>
              <p class="text-zinc-600 text-xs md:text-sm">Setiap Hari: {LOCATION.operatingHours}</p>
            </div>
          </div>
          
          <div class="flex items-start gap-3">
            <div class="flex justify-center items-center bg-emerald-100 rounded-lg w-9 md:w-10 h-9 md:h-10 text-base md:text-lg shrink-0">📧</div>
            <div>
              <p class="font-semibold text-zinc-800 text-xs md:text-sm">Email</p>
              <a href={`mailto:${LOCATION.email}`} class="text-sky-600 hover:text-sky-700 text-xs md:text-sm transition-colors">{LOCATION.email}</a>
            </div>
          </div>
          
          <div class="flex items-start gap-3">
            <div class="flex justify-center items-center bg-green-100 rounded-lg w-9 md:w-10 h-9 md:h-10 text-base md:text-lg shrink-0">📱</div>
            <div>
              <p class="font-semibold text-zinc-800 text-xs md:text-sm">WhatsApp</p>
              <div class="flex flex-col gap-1.5">
                <div class="flex flex-col">
                  <a href={`https://wa.me/62${LOCATION.whatsapp[0].substring(1)}`} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-2 hover:bg-zinc-100 p-1 rounded-md transition-colors">
                    <span class="font-bold text-sky-600 group-hover:text-sky-700 text-xs md:text-sm">(+62) {LOCATION.whatsapp[0].substring(1)}</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <a 
          href={LOCATION.mapsUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex justify-center items-center gap-2 bg-zinc-900 hover:bg-sky-600 px-5 md:px-6 py-2.5 md:py-3 rounded-xl w-full md:w-auto font-bold text-white text-sm transition-colors"
        >
          <span>🗺️</span>
          Buka di Google Maps
        </a>
      </div>
    </div>
  </div>
</section>
