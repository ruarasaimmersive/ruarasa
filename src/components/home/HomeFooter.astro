---
// src/components/home/HomeFooter.astro
import { LOCATION } from '../../constants';
---
<!-- FOOTER -->
<footer class="bg-zinc-900 pt-12 md:pt-20 pb-8 md:pb-10 border-zinc-800 border-t">
    <div class="gap-8 md:gap-12 grid grid-cols-2 md:grid-cols-4 mx-auto mb-10 md:mb-16 px-6 max-w-7xl">
        <div class="col-span-2 md:col-span-2">
            <a href="/" class="block mb-4 md:mb-6">
              <img src="/logo.svg" alt="RuaRasa" class="h-8 md:h-10" />
            </a>
            <p class="mb-4 md:mb-6 max-w-sm font-medium text-zinc-400 text-sm md:text-base">Destinasi wisata edukasi dan hiburan imersif pertama di Lombok. Menghidupkan sejarah melalui teknologi.</p>
            <div class="flex gap-3 md:gap-4">
                <a href="https://www.instagram.com/ruarasalombok/" target="_blank" class="flex justify-center items-center bg-zinc-800 hover:bg-sky-600 rounded-full w-10 md:w-12 h-10 md:h-12 text-zinc-400 hover:text-white transition-colors" aria-label="Instagram">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                </a>
                <a href={`https://wa.me/62${LOCATION.whatsapp[0].substring(1)}`} target="_blank" class="flex justify-center items-center bg-zinc-800 hover:bg-sky-600 rounded-full w-10 md:w-12 h-10 md:h-12 text-zinc-400 hover:text-white transition-colors" aria-label="WhatsApp">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                </a>
            </div>
        </div>
        
        <div>
            <h4 class="mb-3 md:mb-4 font-bold text-white text-base md:text-lg">Menu</h4>
            <ul class="space-y-2 md:space-y-3 font-medium text-zinc-400 text-sm md:text-base">
                <li><a href="/#about" class="hover:text-sky-400 transition-colors">Tentang</a></li>
                <li><a href="/#explore" class="hover:text-sky-400 transition-colors">Wahana</a></li>
                <li><a href="/#ticket" class="hover:text-sky-400 transition-colors">Harga</a></li>
                <!-- <li><a href="/lacx" class="text-amber-500 hover:text-amber-400 font-bold transition-colors">Kelas Budaya</a></li> -->
                <li><a href="/#faq" class="hover:text-sky-400 transition-colors">FAQ</a></li>
                <li><a href="/outing" class="hover:text-sky-400 transition-colors">Outing</a></li>
            </ul>
        </div>
        
        <div>
            <h4 class="mb-3 md:mb-4 font-bold text-white text-base md:text-lg">Kontak</h4>
            <p class="mb-3 font-medium text-zinc-400 text-xs md:text-sm leading-relaxed">{LOCATION.address}</p>
            <div class="space-y-1">
              <a href={`https://wa.me/62${LOCATION.whatsapp[0].substring(1)}`} target="_blank" rel="noopener noreferrer" class="block font-bold text-sky-500 hover:text-sky-400 text-sm md:text-base transition-colors">(+62) {LOCATION.whatsapp[0].substring(1)}</a>
            </div>
        </div>
    </div>
    <div class="mx-auto px-6 pt-6 md:pt-8 border-zinc-800 border-t max-w-7xl font-medium text-zinc-500 text-xs md:text-sm text-center">
        &copy; 2026 Rua Rasa Lombok. All rights reserved.
    </div>
</footer>
