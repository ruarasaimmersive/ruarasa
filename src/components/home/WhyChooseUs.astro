---
// src/components/home/WhyChooseUs.astro
---
<!-- KENAPA KE RUA RASA? Section -->
<section id="facilities" class="bg-white py-16 md:py-24">
  <div class="mx-auto px-6 max-w-6xl">
    <div class="mb-10 md:mb-14 text-center">
      <h2 class="mb-3 font-black text-zinc-900 text-3xl md:text-4xl lg:text-5xl">Kenapa ke <span class="text-sky-600">Rua Rasa</span>?</h2>
      <p class="mx-auto max-w-2xl font-medium text-zinc-500 text-base md:text-lg">Lebih dari sekadar wisata — ini adalah pengalaman yang memadukan edukasi, hiburan, dan momen berharga bersama keluarga.</p>
    </div>
    
    <div class="gap-6 md:gap-8 grid grid-cols-2 md:grid-cols-4">
      <!-- Reason 1: Edukasi Interaktif -->
      <div class="group relative p-5 md:p-6 text-center">
        <div class="absolute inset-0 bg-white/50 opacity-0 group-hover:opacity-100 blur-xl rounded-3xl transition-opacity duration-500"></div>
        <div class="z-10 relative flex justify-center items-center bg-linear-to-br from-sky-400 to-blue-500 shadow-blue-200 shadow-lg group-hover:shadow-blue-400 mx-auto mb-4 rounded-2xl w-16 md:w-20 h-16 md:h-20 text-white transition-all group-hover:-translate-y-2 duration-300 transform">
          <!-- Lightbulb Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="drop-shadow-md w-8 md:w-10 h-8 md:h-10"><path d="M12 2C7.58 2 4 5.58 4 10c0 2.62 1.27 4.93 3.22 6.43.27.21.45.54.45.88V19c0 1.1.9 2 2 2h4.66c1.1 0 2-.9 2-2v-1.69c0-.34.18-.67.45-.88C18.73 14.93 20 12.62 20 10c0-4.42-3.58-8-8-8zm4 10.3c-1.84 1.4-2.82 2.9-3 5.4H11c-.18-2.5-1.16-4-3-5.4C6.8 11.4 6 10.7 6 10c0-3.31 2.69-6 6-6s6 2.69 6 6c0 .7-.8 1.4-2 2.3z"/><path d="M11 21h2v1h-2z" opacity=".5"/></svg>
        </div>
        <h3 class="mb-2 font-bold text-zinc-900 text-sm md:text-base">Edukasi Interaktif</h3>
        <p class="text-zinc-500 text-xs md:text-sm leading-relaxed">Belajar sejarah & budaya Sasak lewat visual yang memukau</p>
      </div>
      
      <!-- Reason 2: Instagrammable -->
      <div class="group relative p-5 md:p-6 text-center">
        <div class="absolute inset-0 bg-white/50 opacity-0 group-hover:opacity-100 blur-xl rounded-3xl transition-opacity duration-500"></div>
        <div class="z-10 relative flex justify-center items-center bg-linear-to-br from-violet-400 to-fuchsia-500 shadow-lg shadow-violet-200 group-hover:shadow-violet-400 mx-auto mb-4 rounded-2xl w-16 md:w-20 h-16 md:h-20 text-white transition-all group-hover:-translate-y-2 duration-300 transform">
            <!-- Camera Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="drop-shadow-md w-8 md:w-10 h-8 md:h-10"><path d="M12 9a3.75 3.75 0 100 7.5A3.75 3.75 0 0012 9z" /><path fill-rule="evenodd" d="M9.344 3.071a49.52 49.52 0 015.312 0c.967.052 1.83.585 2.332 1.39l.821 1.317c.24.383.645.643 1.11.71.386.054.77.113 1.152.177 1.432.239 2.429 1.493 2.429 2.909V18a3 3 0 01-3 3h-15a3 3 0 01-3-3V9.574c0-1.416.997-2.67 2.429-2.909.382-.064.766-.123 1.151-.178a1.56 1.56 0 001.11-.71l.822-1.315a2.942 2.942 0 012.332-1.39zM6.75 12.75a5.25 5.25 0 1110.5 0 5.25 5.25 0 01-10.5 0zm12-1.5a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" /></svg>
        </div>
        <h3 class="mb-2 font-bold text-zinc-900 text-sm md:text-base">Instagrammable</h3>
        <p class="text-zinc-500 text-xs md:text-sm leading-relaxed">Banyak spot foto aesthetic untuk konten yang stunning</p>
      </div>
      
      <!-- Reason 3: Ramah Keluarga -->
      <div class="group relative p-5 md:p-6 text-center">
        <div class="absolute inset-0 bg-white/50 opacity-0 group-hover:opacity-100 blur-xl rounded-3xl transition-opacity duration-500"></div>
        <div class="z-10 relative flex justify-center items-center bg-linear-to-br from-amber-400 to-orange-500 shadow-lg shadow-orange-200 group-hover:shadow-orange-400 mx-auto mb-4 rounded-2xl w-16 md:w-20 h-16 md:h-20 text-white transition-all group-hover:-translate-y-2 duration-300 transform">
            <!-- Users Icon (Family) -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="drop-shadow-md w-8 md:w-10 h-8 md:h-10"><path d="M4.5 6.375a4.125 4.125 0 118.25 0 4.125 4.125 0 01-8.25 0zM14.25 8.625a3.375 3.375 0 116.75 0 3.375 3.375 0 01-6.75 0zM1.5 19.125a7.125 7.125 0 0114.25 0v.003l-.001.119a.75.75 0 01-.363.63 13.067 13.067 0 01-6.761 1.873c-2.472 0-4.786-.684-6.76-1.873a.75.75 0 01-.364-.63l-.001-.122zM17.25 19.128l-.001.144a2.25 2.25 0 01-.233.96 10.088 10.088 0 005.06-1.01.75.75 0 00.42-.643 4.875 4.875 0 00-4.875-4.875h-.452a8.625 8.625 0 01.077 5.424z" /></svg>
        </div>
        <h3 class="mb-2 font-bold text-zinc-900 text-sm md:text-base">Ramah Keluarga</h3>
        <p class="text-zinc-500 text-xs md:text-sm leading-relaxed">Area bermain anak, café, & spot foto untuk semua usia</p>
      </div>

      <!-- Reason 4: Harga Terjangkau -->
      <div class="group relative p-5 md:p-6 text-center">
        <div class="absolute inset-0 bg-white/50 opacity-0 group-hover:opacity-100 blur-xl rounded-3xl transition-opacity duration-500"></div>
        <div class="z-10 relative flex justify-center items-center bg-linear-to-br from-emerald-400 to-teal-500 shadow-lg shadow-teal-200 group-hover:shadow-teal-400 mx-auto mb-4 rounded-2xl w-16 md:w-20 h-16 md:h-20 text-white transition-all group-hover:-translate-y-2 duration-300 transform">
            <!-- Gift Box Icon (Best Value) -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="drop-shadow-md w-8 md:w-10 h-8 md:h-10"><path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 00-5.25 5.25v3a3 3 0 00-3 3v6.75a3 3 0 003 3h10.5a3 3 0 003-3v-6.75a3 3 0 00-3-3v-3c0-2.9-2.35-5.25-5.25-5.25zm3.75 8.25v-3a3.75 3.75 0 10-7.5 0v3h7.5z" clip-rule="evenodd" /><path d="M9.75 14.25a.75.75 0 00-1.5 0v3a.75.75 0 001.5 0v-3zM12.75 14.25a.75.75 0 00-1.5 0v3a.75.75 0 001.5 0v-3zM15.75 14.25a.75.75 0 00-1.5 0v3a.75.75 0 001.5 0v-3z" /></svg>
        </div>
        <h3 class="mb-2 font-bold text-zinc-900 text-sm md:text-base">Harga Terjangkau</h3>
        <p class="text-zinc-500 text-xs md:text-sm leading-relaxed">Mulai 35rb sudah dapat akses wahana seru!</p>
      </div>
    </div>
  </div>
</section>
