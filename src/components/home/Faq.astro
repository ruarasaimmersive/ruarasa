---
// src/components/home/Faq.astro
import { LOCATION, FAQ_DATA } from '../../constants';
---
<!-- FAQ Section -->
<section id="faq" class="bg-zinc-900 py-16 md:py-24 border-zinc-800 border-t">
  <div class="gap-12 lg:gap-24 grid grid-cols-1 lg:grid-cols-12 mx-auto px-6 max-w-6xl">
    <!-- FAQ Left: Header -->
    <div class="lg:col-span-4">
      <h2 class="mb-4 font-black text-white text-4xl md:text-5xl tracking-tight">FAQ</h2>
      <p class="mb-6 md:mb-8 font-medium text-zinc-400 text-base md:text-lg leading-relaxed">
        Punya pertanyaan seputar Rua Rasa? Temukan jawabannya di sini atau hubungi kami langsung.
      </p>
      <a href={`https://wa.me/62${LOCATION.whatsapp[0].substring(1)}?text=Halo%20Rua%20Rasa,%20saya%20mau%20tanya%20seputar%20informasi%20umum`} target="_blank" class="group inline-flex items-center gap-2 font-bold text-sky-400 hover:text-sky-300 text-base md:text-lg transition-colors">
        <span>Hubungi via WhatsApp</span>
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>

    <!-- FAQ Right: Accordion -->
    <div class="space-y-4 lg:col-span-8">
      {FAQ_DATA.map((faq, index) => (
        <div class={`group bg-zinc-800/50 hover:bg-zinc-800 border border-zinc-700 hover:border-zinc-600 rounded-2xl md:rounded-3xl overflow-hidden transition-all duration-300 faq-item ${index === 0 ? 'active' : ''}`}>
          <button class="flex justify-between items-center bg-transparent p-4 md:p-6 focus:outline-none w-full text-left cursor-pointer" onclick="toggleFaq(this)">
            <span class="font-bold text-white text-base md:text-xl">{faq.question}</span>
            <span class={`ml-4 text-sky-500 text-2xl origin-center transition-transform duration-300 transform icon-plus ${index === 0 ? 'rotate-45' : ''}`}>＋</span>
          </button>
          <div class={`px-4 md:px-6 font-medium text-zinc-400 text-sm md:text-base leading-relaxed transition-all duration-500 content ${index === 0 ? 'opacity-100 pb-4 md:pb-6 max-h-[500px]' : 'opacity-0 max-h-0 overflow-hidden'}`}>
            {faq.answer}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  function toggleFaq(button) {
    const currentItem = button.parentElement;
    const content = currentItem.querySelector('.content');
    const icon = button.querySelector('.icon-plus');
    const allItems = document.querySelectorAll('.faq-item');

    // Close all other items
    allItems.forEach(item => {
      if (item !== currentItem && item.classList.contains('active')) {
        item.classList.remove('active');
        const itemContent = item.querySelector('.content');
        const itemIcon = item.querySelector('.icon-plus');
        
        itemContent.style.maxHeight = '0';
        itemContent.style.opacity = '0';
        itemContent.style.paddingBottom = '0';
        itemIcon.style.transform = 'rotate(0deg)';
      }
    });

    // Toggle current item
    if (currentItem.classList.contains('active')) {
      // Close
      currentItem.classList.remove('active');
      content.style.maxHeight = '0';
      content.style.opacity = '0';
      content.style.paddingBottom = '0';
      icon.style.transform = 'rotate(0deg)';
    } else {
      // Open
      currentItem.classList.add('active');
      content.style.maxHeight = content.scrollHeight + 32 + 'px'; // 32px for padding
      content.style.opacity = '1';
      content.style.paddingBottom = '2em'; // Restore padding
      icon.style.transform = 'rotate(45deg)';
    }
  }
</script>
