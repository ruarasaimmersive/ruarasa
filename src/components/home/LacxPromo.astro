---
// src/components/home/LacxPromo.astro
import { LOCATION } from '../../constants';

// Format WhatsApp URL dynamically from LOCATION
const rawWhatsapp = LOCATION.whatsapp[0]; // '08533877719'
const formattedWhatsapp = rawWhatsapp.startsWith('0') ? '62' + rawWhatsapp.slice(1) : rawWhatsapp;
const waText = encodeURIComponent("Halo Rua Rasa, saya tertarik untuk bertanya lebih lanjut mengenai program Kelas Budaya Sasak (LACX). Bisa dibantu?");
const waUrl = `https://wa.me/${formattedWhatsapp}?text=${waText}`;
---
<section class="relative bg-zinc-950 py-20 overflow-hidden text-white">
  <!-- Decorative glowing gradient blobs -->
  <div class="top-1/2 left-1/4 absolute bg-amber-500/20 blur-[120px] rounded-full w-[350px] h-[350px] -translate-y-1/2 pointer-events-none"></div>
  <div class="top-1/3 right-1/4 absolute bg-orange-600/15 blur-[100px] rounded-full w-[250px] h-[250px] pointer-events-none"></div>

  <div class="z-10 relative mx-auto px-6 max-w-7xl">
    <div class="relative bg-linear-to-br from-zinc-900 via-zinc-900 to-zinc-800/80 shadow-2xl p-8 md:p-16 border border-zinc-800 rounded-[2.5rem] overflow-hidden">
      <!-- Background pattern layer -->
      <div class="absolute inset-0 bg-[radial-gradient(#f59e0b_1px,transparent_1px)] opacity-5 pointer-events-none bg-size-[24px_24px]"></div>
      
      <div class="items-center gap-8 lg:gap-12 grid lg:grid-cols-12">
        <!-- Text details -->
        <div class="lg:col-span-7 order-2 lg:order-1 mt-8 lg:mt-0" data-aos="fade-right">
          <span class="inline-flex items-center gap-2 bg-amber-500/10 mb-6 px-4 py-1.5 border border-amber-500/20 rounded-full font-bold text-amber-500 text-xs uppercase tracking-widest">
            ✨ Program Edukasi Unggulan
          </span>
          <h2 class="mb-6 font-black text-3xl md:text-5xl leading-tight">
            Kelas Budaya Sasak <br />
            <span class="bg-clip-text bg-linear-to-r from-amber-400 via-orange-400 to-amber-500 text-transparent">
              Belajar Langsung dari Maestro
            </span>
          </h2>
          <p class="mb-8 font-medium text-zinc-300 text-base md:text-lg leading-relaxed">
            Jangan hanya menonton—rasakan, pelajari, dan kuasai mahakarya seni budaya Sasak. Mulai dari seni tempa kriya logam keris kuno, menenun kain tradisional Sasak, menari Gandrung, hingga beladiri Perisean. Dibimbing oleh para maestro berlisensi akademik.
          </p>
          <div class="flex flex-col sm:flex-row items-center gap-4 w-full">
            <a 
              href="/lacx" 
              class="w-full sm:w-56 text-center flex justify-center items-center py-4 bg-amber-500 hover:bg-amber-400 shadow-amber-500/20 shadow-xl hover:shadow-amber-400/30 rounded-2xl font-extrabold text-zinc-900 transition-all hover:-translate-y-1 transform"
            >
              Lihat Detail Kelas →
            </a>
            <a 
              href={waUrl}
              target="_blank"
              class="w-full sm:w-56 text-center flex justify-center items-center py-4 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 rounded-2xl font-bold text-zinc-200 hover:text-white transition-all"
            >
              Konsultasi via WA
            </a>
          </div>
        </div>

        <!-- Preview visuals -->
        <div class="relative lg:col-span-5 order-1 lg:order-2" data-aos="fade-left">
          <div class="relative shadow-2xl border border-white/10 rounded-3xl aspect-4/3 overflow-hidden">
            <img 
              src="/lacx/brochure-preview.png" 
              alt="Brosur Kelas Budaya" 
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
