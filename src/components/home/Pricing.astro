---
// src/components/home/Pricing.astro
import { LOCATION } from '../../constants';
import { getTicketPackagesFromDB } from '../../lib/supabase';

const getFeatureMeta = (feat: string) => {
  const lower = feat.toLowerCase();
  if (lower.includes('immersive'))
    return { label: 'Akses Area Immersive', icon: '✨' };
  if (lower.includes('nirwana'))
    return { label: 'Voucher Berenang Nirwana Waterpark', icon: '🏊' };
  if (lower.includes('photobooth'))
    return { label: 'Photobooth', icon: '📸' };
  if (lower.includes('kid'))
    return { label: 'Kid Zone (Playground)', icon: '🎈' };
  if (lower.includes('bamboo'))
    return { label: 'Bamboo Land', icon: '🎋' };
  return { label: feat, icon: '🌟' };
};

let packages = [
  {
    id: 'p_reg_35',
    name: 'Tiket Immersive',
    price: '35.000',
    badge: '',
    popular: false,
    rawFeatures: ['Immersive'],
  },
  {
    id: 'p_reg_40',
    name: 'Bundling Nirwana',
    price: '40.000',
    badge: '🏊 Berenang',
    popular: false,
    rawFeatures: ['Immersive', 'Nirwana Waterpark'],
  },
  {
    id: 'p_reg_45',
    name: 'Bundling Ruarasa',
    price: '45.000',
    badge: '🎈 Kid Zone + Photobooth',
    popular: false,
    rawFeatures: ['Immersive', 'Photobooth', 'Kids Zone'],
  },
  {
    id: 'p_reg_55',
    name: 'Tiket All In',
    price: '55.000',
    badge: '🔥 Paket Complete',
    popular: true,
    rawFeatures: ['Immersive', 'Photobooth', 'Kids Zone', 'Nirwana Waterpark'],
  },
];

try {
  const dbRows = await getTicketPackagesFromDB();
  const regulerRows = (dbRows || []).filter(
    (row) => row.group_id === 'g_reguler' || row.variant === 'REGULER'
  );

  if (regulerRows.length > 0) {
    packages = regulerRows.map((row: any) => {
      const feats: string[] = Array.isArray(row.features) ? row.features : ['Immersive'];
      const isPopular =
        typeof row.popular === 'boolean'
          ? row.popular
          : row.id === 'p_reg_55' || row.name.toLowerCase().includes('all in');

      return {
        id: row.id,
        name: row.name,
        price: Number(row.nominal).toLocaleString('id-ID'),
        badge: row.badge || '',
        popular: isPopular,
        rawFeatures: feats,
      };
    });
  }
} catch (err) {
  console.warn('[Pricing.astro] Gagal mengambil harga dari Supabase, memakai default:', err);
}

// Kumpulkan seluruh fitur unik dari paket Reguler (kecuali tag internal 'Event')
const allUniqueFeatures = Array.from(
  new Set(
    packages
      .flatMap((pkg) => pkg.rawFeatures)
      .filter((f) => f.toLowerCase() !== 'event')
  )
);
---

<!-- PRICING SECTION: Comparison Table -->
<section id="ticket" class="bg-zinc-50/70 py-16 md:py-24 border-zinc-200 border-t">
  <div class="mx-auto px-4 sm:px-6 max-w-7xl">
    
    <!-- Section Header -->
    <div class="mb-12 md:mb-16 text-center">
      <span class="inline-block bg-sky-100 mb-3 px-3 py-1 border border-sky-200 rounded-full font-bold text-sky-700 text-xs uppercase tracking-widest">
        Daftar Paket Tiket
      </span>
      <h2 class="mb-3 font-black text-zinc-900 text-3xl md:text-4xl">Pilihan Tiket & Perbandingan Fasilitas</h2>
      <p class="font-medium text-zinc-600 text-base md:text-lg">Bandingkan fasilitas wahana dan temukan paket liburan terbaik untukmu!</p>
    </div>

    <!-- COMPARISON TABLE (Desktop & Tablet) -->
    <div class="hidden md:block bg-white shadow-xl shadow-zinc-200/50 mb-12 border border-zinc-200 rounded-3xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-zinc-900 text-white">
              <th class="p-6 w-1/4 font-extrabold text-sm uppercase align-middle tracking-wider">
                Fasilitas Wahana
              </th>
              {packages.map((pkg) => (
                <th class={`p-6 text-center align-top ${pkg.popular ? 'bg-sky-600 text-white' : ''}`}>
                  <div class="flex flex-col justify-between items-center min-h-27.5">
                    <div class="flex justify-center items-center h-12 font-black text-base md:text-lg text-center leading-tight">
                      {pkg.name}
                    </div>
                    <div class="mt-1 font-extrabold text-2xl">
                      Rp {pkg.price}
                    </div>
                    <div class="flex justify-center items-center mt-2 h-6">
                      {pkg.badge ? (
                        <span class={`inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold ${pkg.popular ? 'bg-white/20 text-white' : 'bg-sky-100 text-sky-800'}`}>
                          {pkg.badge}
                        </span>
                      ) : null}
                    </div>
                  </div>
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100">
            {allUniqueFeatures.map((featKey) => {
              const meta = getFeatureMeta(featKey);
              return (
                <tr class="hover:bg-sky-50/40 transition-colors">
                  <td class="p-5 font-bold text-zinc-800 text-sm">
                    <span class="mr-2">{meta.icon}</span> {meta.label}
                  </td>
                  {packages.map((pkg) => {
                    const hasFeature = pkg.rawFeatures.some(
                      (f) => f.toLowerCase() === featKey.toLowerCase()
                    );
                    return (
                      <td class={`p-5 text-center ${pkg.popular ? 'bg-sky-50/20' : ''}`}>
                        {hasFeature ? (
                          <span class="inline-flex justify-center items-center bg-emerald-500 shadow-sm rounded-full w-7 h-7 font-bold text-white text-sm">
                            ✓
                          </span>
                        ) : (
                          <span class="inline-flex justify-center items-center rounded-full w-7 h-7 font-semibold text-zinc-300 text-sm">
                            -
                          </span>
                        )}
                      </td>
                    );
                  })}
                </tr>
              );
            })}
          </tbody>
          <tfoot>
            <tr class="bg-zinc-50 border-zinc-200 border-t">
              <td class="p-6 font-bold text-zinc-500 text-xs">OPSI PESANAN</td>
              {packages.map((pkg) => (
                <td class="p-5 text-center">
                  <a
                    href="/ticket"
                    class={`inline-block w-full py-3 px-4 rounded-xl font-bold text-xs md:text-sm text-center transition-all ${
                      pkg.popular
                        ? 'bg-sky-600 hover:bg-sky-700 text-white shadow-lg shadow-sky-500/25 hover:-translate-y-0.5'
                        : 'bg-zinc-900 hover:bg-zinc-800 text-white hover:-translate-y-0.5'
                    }`}
                  >
                    Pesan Tiket →
                  </a>
                </td>
              ))}
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

    <!-- CARDS LAYOUT (Mobile View) -->
    <div class="md:hidden space-y-4 mb-12">
      {packages.map((pkg) => (
        <div class={`bg-white p-5 rounded-2xl border-2 transition-all ${pkg.popular ? 'border-sky-500 shadow-lg' : 'border-zinc-200 shadow-sm'}`}>
          <div class="flex justify-between items-start mb-3">
            <div>
              <h3 class="font-extrabold text-zinc-900 text-lg">{pkg.name}</h3>
              {pkg.badge && <span class="bg-sky-100 px-2 py-0.5 rounded-full font-bold text-[10px] text-sky-700">{pkg.badge}</span>}
            </div>
            <div class="font-black text-sky-600 text-xl">Rp {pkg.price}</div>
          </div>
          <div class="my-3 border-zinc-100 border-t"></div>
          <ul class="space-y-2 mb-4 font-medium text-zinc-700 text-xs">
            {allUniqueFeatures.map((featKey) => {
              const meta = getFeatureMeta(featKey);
              const hasFeature = pkg.rawFeatures.some(
                (f) => f.toLowerCase() === featKey.toLowerCase()
              );
              return (
                <li class="flex items-center gap-2">
                  <span class={hasFeature ? 'text-emerald-500 font-bold' : 'text-zinc-300'}>
                    {hasFeature ? '✓' : '✗'}
                  </span>
                  <span class={hasFeature ? 'text-zinc-800 font-semibold' : 'text-zinc-400 line-through'}>
                    {meta.icon} {meta.label}
                  </span>
                </li>
              );
            })}
          </ul>
          <a href="/ticket" class={`block w-full py-2.5 rounded-xl font-bold text-xs text-center ${pkg.popular ? 'bg-sky-600 text-white' : 'bg-zinc-900 text-white'}`}>
            Pesan Tiket Sekarang →
          </a>
        </div>
      ))}
    </div>

    <!-- EXTRA PACKAGES: Custom Rombongan -->
    <div class="gap-6 grid grid-cols-1">
      <div class="relative flex flex-col bg-white p-6 md:p-8 border-2 border-zinc-300 hover:border-sky-400 border-dashed rounded-3xl overflow-hidden transition-colors soft-panel">
        <div class="top-0 right-0 absolute bg-linear-to-r from-sky-500 to-blue-600 shadow-md px-3 py-1 rounded-tr-3xl rounded-bl-xl font-bold text-[10px] text-white uppercase tracking-wider">
           ROMBONGAN &amp; ACARA
        </div>
        <h3 class="mb-1 font-bold text-zinc-500 text-xs uppercase tracking-widest">PAKET SPESIAL</h3>
        <h4 class="mb-4 font-black text-zinc-900 text-2xl md:text-3xl">Custom</h4>
        
        <p class="mb-4 font-medium text-zinc-600 text-xs md:text-sm leading-relaxed">
           Pilihan terbaik untuk kunjungan beregu. Dapatkan penawaran harga &amp; fasilitas khusus untuk:
        </p>
        <ul class="space-y-2.5 mb-6 font-semibold text-zinc-700 text-xs md:text-sm grow">
            <li class="flex items-center gap-2">
              <span class="font-bold text-sky-500">★</span> Kunjungan Rombongan &amp; Outing Class
            </li>
            <li class="flex items-center gap-2">
              <span class="font-bold text-sky-500">★</span> Gathering Komunitas / Kantor
            </li>
            <li class="flex items-center gap-2">
              <span class="font-bold text-sky-500">★</span> Ulang Tahun / Private Event
            </li>
        </ul>
        
        <a
          href={`https://wa.me/62${LOCATION.whatsapp[0].substring(1)}?text=Halo%20Rua%20Rasa,%20saya%20tertarik%20untuk%20bertanya%20lebih%20lanjut%20tentang%20paket%20rombongan`}
          target="_blank"
          class="block bg-sky-50 hover:bg-sky-500 py-3.5 border border-sky-200 hover:border-sky-500 rounded-xl w-full font-bold text-sky-700 hover:text-white text-xs md:text-sm text-center transition-all cursor-pointer"
        >
          Hubungi via WhatsApp →
        </a>
      </div>
    </div>

  </div>
</section>